APP_ENV=production
APP_TIMEZONE=America/New_York
APP_BASE_URL=https://your-server.example.edu
APP_AUTH_USERNAME=admin
# Preferred: SHA-256 hex digest of the password
APP_AUTH_PASSWORD_HASH=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Backward-compatible fallback if APP_AUTH_PASSWORD_HASH is omitted
APP_AUTH_PASSWORD=change_me

POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=change_me
POSTGRESQL_DATABASE=ema_random
POSTGRESQL_SERVICE_HOST=your-postgres-host
POSTGRESQL_SERVICE_PORT=5432

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
